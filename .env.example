DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVER-ONLY-SERVICE-KEY
OPENROUTER_API_KEY=YOUR-SERVER-ONLY-OPENROUTER-KEY
ENVIRONMENT=production
PLANNER_MODEL=openai/gpt-5.6-terra
FAST_MODEL=google/gemini-3.5-flash-lite
CONTENT_MODEL=anthropic/claude-sonnet-5
EMBEDDING_MODEL=openai/text-embedding-3-small
TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
SPEECH_MODEL=hexgrad/kokoro-82m
SPEECH_VOICE=af_heart
MAX_RUN_COST=1.0
MAX_WORKSPACE_RUNS=60
